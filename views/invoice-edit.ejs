<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Edit Invoice</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
    
    body {
      font-family: 'Inter', sans-serif;
    }
  </style>
</head>
<body class="bg-gradient-to-br from-slate-50 to-slate-100 min-h-screen">
  
  <!-- Navigation Bar -->
  <nav class="bg-white shadow-md border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-6 py-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center space-x-4">
          <button onclick="window.location.href='/invoice'" class="flex items-center space-x-2 px-4 py-2 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors">
            <svg class="w-5 h-5 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            <span class="text-slate-700 font-medium">Back to Invoices</span>
          </button>
          
          <div class="h-8 w-px bg-slate-300"></div>
          
          <div>
            <h1 class="text-2xl font-bold text-slate-800">Edit Invoice</h1>
            <p class="text-xs text-slate-500">Update invoice information</p>
          </div>
        </div>
      </div>
    </div>
  </nav>

  <!-- Loading State -->
  <div id="loading" class="max-w-7xl mx-auto px-6 py-20 text-center">
    <div class="inline-flex items-center justify-center w-16 h-16 bg-blue-100 rounded-full mb-4 animate-pulse">
      <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
      </svg>
    </div>
    <h2 class="text-xl font-semibold text-slate-700">Loading invoice...</h2>
    <p class="text-slate-500 mt-2">Please wait while we fetch the invoice details</p>
  </div>

  <!-- Main Content -->
  <div id="main-content" class="max-w-7xl mx-auto px-6 py-8" style="display: none;">
    <form id="invoice-form">
      <!-- Invoice Information Section -->
      <div class="bg-white rounded-xl shadow-md border border-slate-200 overflow-hidden mb-6">
        <div class="px-6 py-4 bg-gradient-to-r from-yellow-50 to-orange-50 border-b border-slate-200">
          <h3 class="text-lg font-semibold text-slate-800 flex items-center">
            <svg class="w-5 h-5 mr-2 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Invoice Information
          </h3>
        </div>
        
        <div class="p-6 space-y-4">
          <div class="bg-gradient-to-r from-slate-100 to-slate-200 p-4 rounded-lg">
            <p class="text-xs text-slate-600 mb-1">Invoice Number</p>
            <p id="invoice-number-display" class="text-2xl font-bold text-slate-800"></p>
          </div>
          
          <div class="bg-slate-50 p-4 rounded-lg space-y-2">
            <h4 class="font-semibold text-slate-700 mb-2">Vendor Details</h4>
            <p class="text-sm"><span class="font-semibold text-slate-700">Name:</span> <span id="vendor-name" class="text-slate-600"></span></p>
            <p class="text-sm"><span class="font-semibold text-slate-700">Email:</span> <span id="vendor-email" class="text-slate-600"></span></p>
            <p class="text-sm"><span class="font-semibold text-slate-700">GST ID:</span> <span id="vendor-gst" class="text-slate-600 font-mono"></span></p>
          </div>

          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2">Invoice Status *</label>
            <select id="status" name="status" required class="w-full p-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent appearance-none bg-white">
              <option value="Draft">Draft</option>
              <option value="Sent">Sent</option>
              <option value="Paid">Paid</option>
              <option value="Cancelled">Cancelled</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Invoice Items Section -->
      <div class="bg-white rounded-xl shadow-md border border-slate-200 overflow-hidden mb-6">
        <div class="px-6 py-4 bg-gradient-to-r from-purple-50 to-blue-50 border-b border-slate-200">
          <h3 class="text-lg font-semibold text-slate-800 flex items-center">
            <svg class="w-5 h-5 mr-2 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
            </svg>
            Invoice Items
          </h3>
        </div>
        
        <div class="p-6">
          <div class="overflow-x-auto">
            <table id="items-table" class="w-full border border-slate-200 rounded-lg overflow-hidden">
              <thead class="bg-gradient-to-r from-blue-600 to-purple-600">
                <tr>
                  <th class="px-4 py-3 text-left text-xs font-semibold text-white uppercase">Product ID</th>
                  <th class="px-4 py-3 text-left text-xs font-semibold text-white uppercase">Product Name</th>
                  <th class="px-4 py-3 text-right text-xs font-semibold text-white uppercase">Quantity</th>
                  <th class="px-4 py-3 text-right text-xs font-semibold text-white uppercase">Rate (₹)</th>
                  <th class="px-4 py-3 text-right text-xs font-semibold text-white uppercase">GST %</th>
                  <th class="px-4 py-3 text-right text-xs font-semibold text-white uppercase">Amount (₹)</th>
                  <th class="px-4 py-3 text-center text-xs font-semibold text-white uppercase">Action</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200"></tbody>
            </table>
          </div>
          
          <button type="button" onclick="addItemRow()" class="mt-4 flex items-center space-x-2 px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors font-semibold">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            <span>Add Item</span>
          </button>
        </div>
      </div>

      <!-- Invoice Summary Section -->
      <div class="bg-white rounded-xl shadow-md border border-slate-200 overflow-hidden mb-6">
        <div class="px-6 py-4 bg-gradient-to-r from-green-50 to-emerald-50 border-b border-slate-200">
          <h3 class="text-lg font-semibold text-slate-800 flex items-center">
            <svg class="w-5 h-5 mr-2 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Invoice Summary
          </h3>
        </div>
        
        <div class="p-6">
          <div class="bg-gradient-to-r from-slate-50 to-slate-100 p-6 rounded-lg border border-slate-200 space-y-3">
            <div class="flex justify-between text-slate-700">
              <span class="font-medium">Subtotal:</span>
              <span class="font-semibold">₹<span id="subtotal">0.00</span></span>
            </div>
            <div class="flex justify-between text-slate-700">
              <span class="font-medium">Total GST:</span>
              <span class="font-semibold">₹<span id="gst-total">0.00</span></span>
            </div>
            <div class="border-t-2 border-slate-300 pt-3">
              <div class="flex justify-between text-2xl font-bold text-green-600">
                <span>Grand Total:</span>
                <span>₹<span id="total">0.00</span></span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex justify-end gap-4">
        <button type="submit" class="px-8 py-3 bg-gradient-to-r from-yellow-500 to-orange-500 text-white rounded-lg hover:shadow-lg transition-all font-semibold flex items-center space-x-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
          <span>Update Invoice</span>
        </button>
      </div>
    </form>
  </div>

  <script>
    let products = [];
    let invoiceId = '';

    window.onload = async () => {
      const pathParts = window.location.pathname.split('/');
      invoiceId = pathParts[pathParts.length - 1];

      try {
        const productRes = await fetch('/api/products');
        products = await productRes.json();

        const invoiceRes = await fetch(`/api/invoices/${invoiceId}`);
        const invoice = await invoiceRes.json();

        document.getElementById('invoice-number-display').textContent = invoice.invoiceNumber;
        document.getElementById('vendor-name').textContent = invoice.vendorName;
        document.getElementById('vendor-email').textContent = invoice.vendorEmail || 'N/A';
        document.getElementById('vendor-gst').textContent = invoice.vendorGstId || 'N/A';
        document.getElementById('status').value = invoice.status;

        invoice.items.forEach(item => {
          addItemRow(item);
        });

        calcTotals();

        document.getElementById('loading').style.display = 'none';
        document.getElementById('main-content').style.display = 'block';
      } catch (err) {
        alert("Failed to load invoice data.");
        console.error(err);
        window.location.href = '/invoice';
      }
    };

    function addItemRow(itemData = null) {
      const row = document.createElement('tr');
      row.className = 'hover:bg-slate-50';
      
      const productOptions = products.map(p => 
        `<option value="${p.product_id}" ${itemData && itemData.product_id === p.product_id ? 'selected' : ''}>${p.product_id}</option>`
      ).join('');

      row.innerHTML = `
        <td class="px-4 py-3">
          <select class="product-select w-full p-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500" required>
            <option value="">-- Select Product --</option>
            ${productOptions}
          </select>
        </td>
        <td class="px-4 py-3 text-sm text-slate-700 pname">${itemData ? itemData.productName : '-'}</td>
        <td class="px-4 py-3">
          <input type="number" class="qty w-20 p-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500 text-right" min="1" value="${itemData ? itemData.quantity : 1}" required>
        </td>
        <td class="px-4 py-3 text-sm text-slate-700 text-right rate">${itemData ? parseFloat(itemData.rate).toFixed(2) : '0.00'}</td>
        <td class="px-4 py-3 text-sm text-slate-700 text-right gst">${itemData ? itemData.gst : '0'}</td>
        <td class="px-4 py-3 text-sm font-semibold text-slate-800 text-right amount">${itemData ? parseFloat(itemData.amount).toFixed(2) : '0.00'}</td>
        <td class="px-4 py-3 text-center">
          <button type="button" onclick="removeRow(this)" class="px-3 py-1 bg-red-100 text-red-600 rounded-lg hover:bg-red-200 transition-colors font-medium text-sm">
            Remove
          </button>
        </td>
      `;
      
      document.querySelector('#items-table tbody').appendChild(row);
      
      row.querySelector('.product-select').addEventListener('change', e => updateProductDetails(e.target));
      row.querySelector('.qty').addEventListener('input', calcTotals);

      if (itemData) {
        updateProductDetails(row.querySelector('.product-select'));
      }
    }

    function removeRow(btn) {
      btn.closest('tr').remove();
      calcTotals();
    }

    function updateProductDetails(select) {
      const row = select.closest('tr');
      const prod = products.find(p => p.product_id === select.value);
      
      if (prod) {
        row.querySelector('.pname').textContent = prod.name;
        row.querySelector('.rate').textContent = parseFloat(prod.price).toFixed(2);
        row.querySelector('.gst').textContent = prod.gst;
        calcTotals();
      } else {
        row.querySelector('.pname').textContent = '-';
        row.querySelector('.rate').textContent = '0.00';
        row.querySelector('.gst').textContent = '0';
        row.querySelector('.amount').textContent = '0.00';
      }
    }

    function calcTotals() {
      let subtotal = 0, gstTotal = 0;
      
      document.querySelectorAll('#items-table tbody tr').forEach(row => {
        const qty = parseFloat(row.querySelector('.qty').value || 0);
        const rate = parseFloat(row.querySelector('.rate').textContent || 0);
        const gst = parseFloat(row.querySelector('.gst').textContent || 0);

        const amt = rate * qty;
        const gstAmt = amt * gst / 100;
        const totalAmt = amt + gstAmt;
        
        row.querySelector('.amount').textContent = totalAmt.toFixed(2);

        subtotal += amt;
        gstTotal += gstAmt;
      });

      document.getElementById('subtotal').textContent = subtotal.toFixed(2);
      document.getElementById('gst-total').textContent = gstTotal.toFixed(2);
      document.getElementById('total').textContent = (subtotal + gstTotal).toFixed(2);
    }

    document.getElementById('invoice-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const status = document.getElementById('status').value;

      const items = [];
      let isValid = true;
      
      document.querySelectorAll('#items-table tbody tr').forEach(row => {
        const product_id = row.querySelector('.product-select').value;
        const quantity = parseFloat(row.querySelector('.qty').value);
        
        if (!product_id || !quantity) {
          isValid = false;
          return;
        }
        
        items.push({
          product_id,
          productName: row.querySelector('.pname').textContent,
          quantity,
          rate: parseFloat(row.querySelector('.rate').textContent),
          gst: parseFloat(row.querySelector('.gst').textContent),
          amount: parseFloat(row.querySelector('.amount').textContent)
        });
      });

      if (!isValid || items.length === 0) {
        alert('Please add at least one valid item');
        return;
      }

      const invoiceData = {
        status,
        items,
        subtotal: parseFloat(document.getElementById('subtotal').textContent),
        gstTotal: parseFloat(document.getElementById('gst-total').textContent),
        total: parseFloat(document.getElementById('total').textContent)
      };

      try {
        const res = await fetch(`/api/invoices/${invoiceId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(invoiceData)
        });

        if (res.ok) {
          alert('Invoice updated successfully!');
          window.location.href = '/invoice';
        } else {
          const error = await res.json();
          alert('Failed to update invoice: ' + (error.message || 'Unknown error'));
        }
      } catch (error) {
        console.error('Error:', error);
        alert('Failed to update invoice. Please try again.');
      }
    });
  </script>
</body>
</html>
