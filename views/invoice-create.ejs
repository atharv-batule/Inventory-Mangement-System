<!--invoice-create.ejs-->

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Create Invoice</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
    
    body {
      font-family: 'Inter', sans-serif;
    }
  </style>
</head>
<body class="bg-gradient-to-br from-slate-50 to-slate-100 min-h-screen">
  
  <!-- Navigation Bar -->
  <nav class="bg-white shadow-md border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-6 py-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center space-x-4">
          <a href="/invoice" class="flex items-center space-x-2 px-4 py-2 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors">
            <svg class="w-5 h-5 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            <span class="text-slate-700 font-medium">Back to Invoices</span>
          </a>
          
          <div class="h-8 w-px bg-slate-300"></div>
          
          <div>
            <h1 class="text-2xl font-bold text-slate-800">Create New Invoice</h1>
            <p class="text-xs text-slate-500">Fill in the details below</p>
          </div>
        </div>
      </div>
    </div>
  </nav>

  <!-- Main Content -->
  <div class="max-w-5xl mx-auto px-6 py-8">
    <div class="bg-white rounded-xl shadow-md border border-slate-200 p-8">
      <form id="invoiceForm">
        
        <!-- Vendor Information -->
        <div class="mb-8">
          <h3 class="text-xl font-bold text-slate-800 mb-4 flex items-center">
            <svg class="w-6 h-6 mr-2 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
            </svg>
            Vendor Information
          </h3>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-2">Vendor *</label>
              <select 
                id="vendorSelect" 
                class="w-full p-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500"
                required
                onchange="loadVendorDetails()"
              >
                <option value="">Select Vendor</option>
              </select>
            </div>
            
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-2">Vendor Email</label>
              <input 
                type="email" 
                id="vendorEmail" 
                class="w-full p-3 border border-slate-300 rounded-lg bg-slate-50" 
                readonly
              />
            </div>
            
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-2">Vendor GST ID</label>
              <input 
                type="text" 
                id="vendorGstId" 
                class="w-full p-3 border border-slate-300 rounded-lg bg-slate-50" 
                readonly
              />
            </div>
            
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-2">Invoice Status *</label>
              <select 
                id="invoiceStatus" 
                class="w-full p-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500"
                required
              >
                <option value="Draft">Draft</option>
                <option value="Sent">Sent</option>
                <option value="Paid">Paid</option>
              </select>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-2">Due Date</label>
              <input 
                type="date" 
                id="dueDate" 
                class="w-full p-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500"
              />
            </div>
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-2">Notes</label>
              <input 
                type="text" 
                id="notes" 
                placeholder="Additional notes (optional)"
                class="w-full p-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500"
              />
            </div>
          </div>
        </div>

        <!-- Invoice Items -->
        <div class="mb-8">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-xl font-bold text-slate-800 flex items-center">
              <svg class="w-6 h-6 mr-2 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
              </svg>
              Invoice Items
            </h3>
            <button 
              type="button" 
              onclick="addItemRow()" 
              class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition-colors flex items-center space-x-2"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
              </svg>
              <span>Add Item</span>
            </button>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full">
              <thead>
                <tr class="bg-slate-50 border-b border-slate-200">
                  <th class="px-4 py-3 text-left text-sm font-semibold text-slate-700">Product</th>
                  <th class="px-4 py-3 text-left text-sm font-semibold text-slate-700">Quantity</th>
                  <th class="px-4 py-3 text-left text-sm font-semibold text-slate-700">Rate (₹)</th>
                  <th class="px-4 py-3 text-left text-sm font-semibold text-slate-700">GST (%)</th>
                  <th class="px-4 py-3 text-left text-sm font-semibold text-slate-700">Amount (₹)</th>
                  <th class="px-4 py-3 text-center text-sm font-semibold text-slate-700">Action</th>
                </tr>
              </thead>
              <tbody id="itemsTableBody">
                <!-- Items will be added here dynamically -->
              </tbody>
            </table>
          </div>

          <div class="mt-4 text-sm text-slate-500 italic">
            * Click "Add Item" to add products to this invoice
          </div>
        </div>

        <!-- Invoice Summary -->
        <div class="bg-gradient-to-r from-slate-50 to-slate-100 rounded-lg p-6 border border-slate-200">
          <h3 class="text-lg font-bold text-slate-800 mb-4">Invoice Summary</h3>
          
          <div class="space-y-3">
            <div class="flex justify-between items-center">
              <span class="text-slate-600">Subtotal:</span>
              <span class="font-semibold text-slate-800">₹<span id="subtotalDisplay">0.00</span></span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-slate-600">GST Total:</span>
              <span class="font-semibold text-slate-800">₹<span id="gstTotalDisplay">0.00</span></span>
            </div>
            <div class="border-t border-slate-300 pt-3 flex justify-between items-center">
              <span class="text-lg font-bold text-slate-800">Total Amount:</span>
              <span class="text-2xl font-bold text-indigo-600">₹<span id="totalDisplay">0.00</span></span>
            </div>
          </div>
        </div>

        <!-- Form Actions -->
        <div class="flex justify-end gap-3 mt-8">
          <a 
            href="/invoice" 
            class="px-6 py-3 bg-slate-200 text-slate-700 rounded-lg hover:bg-slate-300 transition-colors font-medium"
          >
            Cancel
          </a>
          <button 
            type="submit" 
            class="px-6 py-3 bg-gradient-to-r from-indigo-600 to-blue-600 text-white rounded-lg hover:shadow-lg transition-all font-semibold"
          >
            Create Invoice
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    let vendors = [];
    let products = [];
    let itemCounter = 0;

    // Load vendors and products on page load
    window.addEventListener('DOMContentLoaded', async () => {
      await loadVendors();
      await loadProducts();
      addItemRow(); // Add first item row by default
    });

    // Load vendors from API
    async function loadVendors() {
      try {
        const response = await fetch('/api/vendors');
        vendors = await response.json();
        
        const vendorSelect = document.getElementById('vendorSelect');
        vendors.forEach(vendor => {
          const option = document.createElement('option');
          option.value = vendor.vendorId;
          option.textContent = `${vendor.name} (${vendor.vendorId})`;
          option.dataset.email = vendor.email;
          option.dataset.gstId = vendor.gstId;
          option.dataset.name = vendor.name;
          vendorSelect.appendChild(option);
        });
      } catch (error) {
        console.error('Error loading vendors:', error);
        alert('Failed to load vendors');
      }
    }

    // Load products from API
    async function loadProducts() {
      try {
        const response = await fetch('/api/products');
        products = await response.json();
      } catch (error) {
        console.error('Error loading products:', error);
        alert('Failed to load products');
      }
    }

    // Load vendor details when selected
    function loadVendorDetails() {
      const vendorSelect = document.getElementById('vendorSelect');
      const selectedOption = vendorSelect.options[vendorSelect.selectedIndex];
      
      if (selectedOption.value) {
        document.getElementById('vendorEmail').value = selectedOption.dataset.email || '';
        document.getElementById('vendorGstId').value = selectedOption.dataset.gstId || '';
      } else {
        document.getElementById('vendorEmail').value = '';
        document.getElementById('vendorGstId').value = '';
      }
    }

    // Add new item row
    function addItemRow() {
      const tbody = document.getElementById('itemsTableBody');
      const row = document.createElement('tr');
      row.className = 'border-b border-slate-200 item-row';
      row.dataset.itemId = itemCounter++;
      
      row.innerHTML = `
        <td class="px-4 py-3">
          <select 
            class="w-full p-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 product-select"
            onchange="updateItemRow(this)"
            required
          >
            <option value="">Select Product</option>
            ${products.map(p => `
              <option 
                value="${p.product_id}" 
                data-name="${p.name}" 
                data-price="${p.price}" 
                data-gst="${p.gst}"
              >
                ${p.name} (${p.product_id})
              </option>
            `).join('')}
          </select>
        </td>
        <td class="px-4 py-3">
          <input 
            type="number" 
            min="1" 
            value="1" 
            class="w-full p-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 quantity-input"
            onchange="calculateItemAmount(this)"
            required
          />
        </td>
        <td class="px-4 py-3">
          <input 
            type="number" 
            step="0.01" 
            min="0" 
            value="0" 
            class="w-full p-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 rate-input"
            onchange="calculateItemAmount(this)"
            required
          />
        </td>
        <td class="px-4 py-3">
          <input 
            type="number" 
            step="0.01" 
            min="0" 
            value="0" 
            class="w-full p-2 border border-slate-300 rounded-lg bg-slate-50 gst-input"
            readonly
          />
        </td>
        <td class="px-4 py-3">
          <input 
            type="number" 
            step="0.01" 
            min="0" 
            value="0" 
            class="w-full p-2 border border-slate-300 rounded-lg bg-slate-50 amount-input font-semibold"
            readonly
          />
        </td>
        <td class="px-4 py-3 text-center">
          <button 
            type="button" 
            onclick="removeItemRow(this)" 
            class="p-2 text-red-600 hover:bg-red-50 rounded-lg transition-colors"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
            </svg>
          </button>
        </td>
      `;
      
      tbody.appendChild(row);
    }

    // Update item row when product is selected
    function updateItemRow(selectElement) {
      const row = selectElement.closest('tr');
      const selectedOption = selectElement.options[selectElement.selectedIndex];
      
      if (selectedOption.value) {
        const rate = parseFloat(selectedOption.dataset.price);
        const gst = parseFloat(selectedOption.dataset.gst);
        
        row.querySelector('.rate-input').value = rate.toFixed(2);
        row.querySelector('.gst-input').value = gst.toFixed(2);
        
        calculateItemAmount(selectElement);
      }
    }

    // Calculate amount for a specific item
    function calculateItemAmount(element) {
      const row = element.closest('tr');
      const quantity = parseFloat(row.querySelector('.quantity-input').value) || 0;
      const rate = parseFloat(row.querySelector('.rate-input').value) || 0;
      const gst = parseFloat(row.querySelector('.gst-input').value) || 0;
      
      const subtotal = quantity * rate;
      const gstAmount = (subtotal * gst) / 100;
      const total = subtotal + gstAmount;
      
      row.querySelector('.amount-input').value = total.toFixed(2);
      
      calculateInvoiceTotals();
    }

    // Calculate invoice totals
    function calculateInvoiceTotals() {
      const rows = document.querySelectorAll('.item-row');
      let subtotal = 0;
      let gstTotal = 0;
      
      rows.forEach(row => {
        const quantity = parseFloat(row.querySelector('.quantity-input').value) || 0;
        const rate = parseFloat(row.querySelector('.rate-input').value) || 0;
        const gst = parseFloat(row.querySelector('.gst-input').value) || 0;
        
        const itemSubtotal = quantity * rate;
        const itemGst = (itemSubtotal * gst) / 100;
        
        subtotal += itemSubtotal;
        gstTotal += itemGst;
      });
      
      const total = subtotal + gstTotal;
      
      document.getElementById('subtotalDisplay').textContent = subtotal.toFixed(2);
      document.getElementById('gstTotalDisplay').textContent = gstTotal.toFixed(2);
      document.getElementById('totalDisplay').textContent = total.toFixed(2);
    }

    // Remove item row
    function removeItemRow(button) {
      const row = button.closest('tr');
      const tbody = document.getElementById('itemsTableBody');
      
      if (tbody.children.length > 1) {
        row.remove();
        calculateInvoiceTotals();
      } else {
        alert('Invoice must have at least one item');
      }
    }

    // Handle form submission
    document.getElementById('invoiceForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const vendorSelect = document.getElementById('vendorSelect');
      const selectedVendor = vendorSelect.options[vendorSelect.selectedIndex];
      
      if (!selectedVendor.value) {
        alert('Please select a vendor');
        return;
      }

      const rows = document.querySelectorAll('.item-row');
      if (rows.length === 0) {
        alert('Please add at least one item');
        return;
      }

      const items = [];
      let isValid = true;

      rows.forEach(row => {
        const productSelect = row.querySelector('.product-select');
        const selectedProduct = productSelect.options[productSelect.selectedIndex];
        
        if (!selectedProduct.value) {
          isValid = false;
          return;
        }

        items.push({
          product_id: selectedProduct.value,
          productName: selectedProduct.dataset.name,
          quantity: parseFloat(row.querySelector('.quantity-input').value),
          rate: parseFloat(row.querySelector('.rate-input').value),
          gst: parseFloat(row.querySelector('.gst-input').value),
          amount: parseFloat(row.querySelector('.amount-input').value)
        });
      });

      if (!isValid) {
        alert('Please select a product for all items');
        return;
      }

      const invoiceData = {
        vendorId: selectedVendor.value,
        vendorName: selectedVendor.dataset.name,
        vendorEmail: document.getElementById('vendorEmail').value,
        vendorGstId: document.getElementById('vendorGstId').value,
        status: document.getElementById('invoiceStatus').value,
        dueDate: document.getElementById('dueDate').value || null,
        notes: document.getElementById('notes').value,
        items: items,
        subtotal: parseFloat(document.getElementById('subtotalDisplay').textContent),
        gstTotal: parseFloat(document.getElementById('gstTotalDisplay').textContent),
        total: parseFloat(document.getElementById('totalDisplay').textContent)
      };

      try {
        const response = await fetch('/api/invoices/create', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(invoiceData)
        });

        if (response.ok) {
          alert('Invoice created successfully!');
          window.location.href = '/invoice';
        } else {
          const error = await response.json();
          alert('Failed to create invoice: ' + (error.message || 'Unknown error'));
        }
      } catch (error) {
        console.error('Error:', error);
        alert('An error occurred while creating the invoice');
      }
    });
  </script>
</body>
</html>
