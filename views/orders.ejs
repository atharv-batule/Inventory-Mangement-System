<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Order Management</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
    
    body {
      font-family: 'Inter', sans-serif;
    }
    
    .modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-color: rgba(0, 0, 0, 0.5);
      backdrop-filter: blur(4px);
      z-index: 50;
    }
    
    .order-card {
      transition: all 0.3s ease;
    }
    
    .order-card:hover {
      transform: translateX(8px);
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
    }
    
    .dropdown-menu {
      display: none;
      position: absolute;
      right: 0;
      top: 100%;
      margin-top: 0.5rem;
      background: white;
      border-radius: 0.5rem;
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
      z-index: 10;
      min-width: 160px;
    }
    
    .dropdown-menu.active {
      display: block;
    }
    
    .dropdown-menu button {
      width: 100%;
      text-align: left;
      padding: 0.75rem 1rem;
      transition: background-color 0.2s;
    }
    
    .dropdown-menu button:hover {
      background-color: #f8fafc;
    }

    .status-badge {
      display: inline-block;
      padding: 0.25rem 0.75rem;
      border-radius: 9999px;
      font-size: 0.75rem;
      font-weight: 600;
    }

    .status-pending { background-color: #fef3c7; color: #92400e; }
    .status-processing { background-color: #dbeafe; color: #1e40af; }
    .status-shipped { background-color: #e0e7ff; color: #4338ca; }
    .status-delivered { background-color: #dcfce7; color: #15803d; }
    .status-cancelled { background-color: #fee2e2; color: #991b1b; }
  </style>
</head>
<body class="bg-gradient-to-br from-slate-50 to-slate-100 min-h-screen">
  
  <!-- Navigation Bar -->
  <nav class="bg-white shadow-md border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-6 py-4">
      <div class="flex items-center justify-between">
        <!-- Left Side: Back Button + Organization Name -->
        <div class="flex items-center space-x-4">
          <button onclick="window.location.href='/home'" class="flex items-center space-x-2 px-4 py-2 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors">
            <svg class="w-5 h-5 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            <span class="text-slate-700 font-medium">Back</span>
          </button>
          
          <div class="h-8 w-px bg-slate-300"></div>
          
          <div>
            <h1 class="text-2xl font-bold text-slate-800">Inventory Pro</h1>
            <p class="text-xs text-slate-500">Order Management System</p>
          </div>
        </div>
        
        <!-- Right Side: Add Order Button -->
        <button onclick="openAddModal()" class="flex items-center space-x-2 px-6 py-3 bg-gradient-to-r from-green-600 to-emerald-600 text-white rounded-lg hover:shadow-lg transition-all font-semibold">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          <span>Create New Order</span>
        </button>
      </div>
    </div>
  </nav>

  <!-- Main Content -->
  <div class="max-w-7xl mx-auto px-6 py-8">
    
    <!-- Page Header -->
    <div class="mb-8">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-3xl font-bold text-slate-800 mb-2">Order Management</h2>
          <p class="text-slate-600">Track and manage all customer orders</p>
        </div>
        
        <!-- Search Bar -->
        <div class="relative">
          <input 
            type="text" 
            id="searchInput"
            placeholder="Search orders..." 
            class="pl-10 pr-4 py-2 w-80 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent"
            onkeyup="filterOrders()"
          >
          <svg class="w-5 h-5 text-slate-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
      </div>
    </div>

    <!-- Stats Bar -->
    <div class="grid grid-cols-1 md:grid-cols-5 gap-4 mb-8">
      <div class="bg-white rounded-xl p-4 shadow-md border border-slate-200">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm text-slate-600">Total Orders</p>
            <p class="text-2xl font-bold text-slate-800"><%= orders.length %></p>
          </div>
          <div class="p-3 bg-blue-100 rounded-lg">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
            </svg>
          </div>
        </div>
      </div>
      
      <div class="bg-white rounded-xl p-4 shadow-md border border-slate-200">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm text-slate-600">Pending</p>
            <p class="text-2xl font-bold text-yellow-600"><%= orders.filter(o => o.status === 'Pending').length %></p>
          </div>
          <div class="p-3 bg-yellow-100 rounded-lg">
            <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
        </div>
      </div>
      
      <div class="bg-white rounded-xl p-4 shadow-md border border-slate-200">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm text-slate-600">Delivered</p>
            <p class="text-2xl font-bold text-green-600"><%= orders.filter(o => o.status === 'Delivered').length %></p>
          </div>
          <div class="p-3 bg-green-100 rounded-lg">
            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
        </div>
      </div>
      
      <div class="bg-white rounded-xl p-4 shadow-md border border-slate-200">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm text-slate-600">Cancelled</p>
            <p class="text-2xl font-bold text-red-600"><%= orders.filter(o => o.status === 'Cancelled').length %></p>
          </div>
          <div class="p-3 bg-red-100 rounded-lg">
            <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </div>
        </div>
      </div>
      
      <div class="bg-white rounded-xl p-4 shadow-md border border-slate-200">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm text-slate-600">Total Revenue</p>
            <p class="text-2xl font-bold text-purple-600">₹<%= orders.reduce((sum, o) => sum + o.total_amount, 0).toLocaleString() %></p>
          </div>
          <div class="p-3 bg-purple-100 rounded-lg">
            <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
        </div>
      </div>
    </div>

    <!-- Order List -->
    <div class="bg-white rounded-xl shadow-md border border-slate-200">
      <div class="px-6 py-4 bg-gradient-to-r from-slate-50 to-slate-100 border-b border-slate-200">
        <h3 class="text-lg font-semibold text-slate-800">All Orders</h3>
      </div>
      
      <div id="orderList" class="divide-y divide-slate-200">
        <% if (orders.length === 0) { %>
          <div class="p-12 text-center">
            <svg class="w-16 h-16 text-slate-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
            </svg>
            <p class="text-slate-500 text-lg">No orders found</p>
            <p class="text-slate-400 text-sm mt-2">Create your first order to get started</p>
          </div>
        <% } else { %>
          <% orders.forEach((order, index) => { %>
            <div class="order-card p-6 hover:bg-slate-50" 
                 data-order='<%- JSON.stringify(order) %>'>
              <div class="flex items-center justify-between gap-4">
                <div class="flex items-center space-x-4 flex-1 min-w-0">
                  <!-- Order Icon -->
                  <div class="w-14 h-14 flex-shrink-0 bg-gradient-to-br from-green-500 to-emerald-500 rounded-full flex items-center justify-center text-white font-bold text-lg">
                    <%= order.order_id.substring(order.order_id.length - 3) %>
                  </div>
                  
                  <!-- Order Details -->
                  <div class="flex-1 grid grid-cols-7 gap-3 min-w-0">
                    <div class="min-w-0">
                      <p class="text-xs text-slate-500 mb-1">Order ID</p>
                      <p class="font-semibold text-slate-800 truncate"><%= order.order_id %></p>
                    </div>
                    <div class="min-w-0">
                      <p class="text-xs text-slate-500 mb-1">Customer</p>
                      <p class="font-semibold text-slate-800 truncate"><%= order.customer_name %></p>
                      <p class="text-xs text-slate-500 truncate"><%= order.customer_phone %></p>
                    </div>
                    <div class="min-w-0">
                      <p class="text-xs text-slate-500 mb-1">Product</p>
                      <p class="text-slate-700 text-sm truncate"><%= order.product_name %></p>
                    </div>
                    <div class="min-w-0">
                      <p class="text-xs text-slate-500 mb-1">Quantity</p>
                      <p class="text-slate-700 font-semibold truncate"><%= order.quantity %></p>
                    </div>
                    <div class="min-w-0">
                      <p class="text-xs text-slate-500 mb-1">Amount</p>
                      <p class="text-slate-700 font-semibold truncate">₹<%= order.total_amount.toLocaleString() %></p>
                    </div>
                    <div class="min-w-0">
                      <p class="text-xs text-slate-500 mb-1">Status</p>
                      <span class="status-badge status-<%= order.status.toLowerCase() %>"><%= order.status %></span>
                    </div>
                    <div class="min-w-0">
                      <p class="text-xs text-slate-500 mb-1">Payment</p>
                      <p class="text-slate-700 text-sm truncate"><%= order.payment_method %></p>
                    </div>
                  </div>
                </div>
                
                <!-- Three Dot Menu -->
                <div class="relative flex-shrink-0">
                  <button onclick="toggleDropdown('dropdown<%= index %>')" class="p-2 hover:bg-slate-200 rounded-lg transition-colors">
                    <svg class="w-6 h-6 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"></path>
                    </svg>
                  </button>
                  <div id="dropdown<%= index %>" class="dropdown-menu">
                    <button onclick="viewOrder('<%= order._id %>'); toggleDropdown('dropdown<%= index %>')" class="flex items-center space-x-2 text-slate-700 hover:text-blue-600">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                      </svg>
                      <span>View Details</span>
                    </button>
                    <button onclick="openEditModalFromCard(this); toggleDropdown('dropdown<%= index %>')" class="flex items-center space-x-2 text-slate-700 hover:text-yellow-600">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                      </svg>
                      <span>Edit Order</span>
                    </button>
                    <button onclick="deleteOrder('<%= order._id %>'); toggleDropdown('dropdown<%= index %>')" class="flex items-center space-x-2 text-slate-700 hover:text-red-600 border-t border-slate-200">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                      </svg>
                      <span>Delete Order</span>
                    </button>
                  </div>
                </div>
              </div>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Add Order Modal -->
  <div id="addOrderModal" class="modal-overlay hidden flex justify-center items-center">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-3xl mx-4 overflow-hidden max-h-[90vh] overflow-y-auto">
      <div class="bg-gradient-to-r from-green-600 to-emerald-600 px-6 py-4">
        <h2 class="text-2xl font-bold text-white">Create New Order</h2>
        <p class="text-green-100 text-sm">Fill in order details</p>
      </div>
      
      <form action="/add-order" method="POST" class="p-6">
        <!-- Customer Information -->
        <div class="mb-6">
          <h3 class="text-lg font-semibold text-slate-800 mb-3 flex items-center">
            <svg class="w-5 h-5 mr-2 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
            </svg>
            Customer Information
          </h3>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-2">Order ID</label>
              <input 
                name="order_id" 
                type="text" 
                placeholder="e.g., ORD001" 
                class="w-full p-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent" 
                required 
              />
            </div>
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-2">Customer Name</label>
              <input 
                name="customer_name" 
                type="text" 
                placeholder="John Doe" 
                class="w-full p-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent" 
                required 
              />
            </div>
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-2">Email</label>
              <input 
                name="customer_email" 
                type="email" 
                placeholder="john@example.com" 
                class="w-full p-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent" 
                required 
              />
            </div>
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-2">Phone</label>
              <input 
                name="customer_phone" 
                type="tel" 
                placeholder="+91 9876543210" 
                class="w-full p-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent" 
                required 
              />
            </div>
          </div>
        </div>

        <!-- Product Information -->
        <div class="mb-6">
          <h3 class="text-lg font-semibold text-slate-800 mb-3 flex items-center">
            <svg class="w-5 h-5 mr-2 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
            </svg>
            Product Details
          </h3>
          <div class="grid grid-cols-3 gap-4">
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-2">Product Name</label>
              <input 
                name="product_name" 
                type="text" 
                placeholder="Product name" 
                class="w-full p-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent" 
                required 
              />
            </div>
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-2">Quantity</label>
              <input 
                name="quantity" 
                type="number" 
                min="1"
                placeholder="1" 
                id="addQuantity"
                oninput="calculateTotal('add')"
                class="w-full p-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent" 
                required 
              />
            </div>
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-2">Unit Price (₹)</label>
              <input 
                name="unit_price" 
                type="number" 
                step="0.01"
                min="0"
                placeholder="0.00"
                id="addUnitPrice"
                oninput="calculateTotal('add')"
                class="w-full p-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent" 
                required 
              />
            </div>
          </div>
          <div class="mt-4">
            <label class="block text-sm font-semibold text-slate-700 mb-2">Total Amount (₹)</label>
            <input 
              name="total_amount" 
              type="number" 
              step="0.01"
              id="addTotalAmount"
              placeholder="0.00" 
              class="w-full p-3 border border-slate-300 rounded-lg bg-slate-50 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent" 
              readonly
              required 
            />
          </div>
        </div>

        <!-- Order Details -->
        <div class="mb-6">
          <h3 class="text-lg font-semibold text-slate-800 mb-3 flex items-center">
            <svg class="w-5 h-5 mr-2 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
            </svg>
            Order Details
          </h3>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-2">Status</label>
              <select 
                name="status" 
                class="w-full p-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent" 
                required
              >
                <option value="Pending">Pending</option>
                <option value="Processing">Processing</option>
                <option value="Shipped">Shipped</option>
                <option value="Delivered">Delivered</option>
                <option value="Cancelled">Cancelled</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-2">Payment Method</label>
              <select 
                name="payment_method" 
                class="w-full p-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent" 
                required
              >
                <option value="" disabled selected>Select payment method</option>
                <option value="Cash">Cash</option>
                <option value="Card">Card</option>
                <option value="UPI">UPI</option>
                <option value="Net Banking">Net Banking</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Shipping Address -->
        <div class="mb-6">
          <label class="block text-sm font-semibold text-slate-700 mb-2">Shipping Address</label>
          <textarea 
            name="shipping_address" 
            rows="3"
            placeholder="Enter complete shipping address" 
            class="w-full p-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent" 
            required
          ></textarea>
        </div>

        <!-- Notes -->
        <div class="mb-6">
          <label class="block text-sm font-semibold text-slate-700 mb-2">Notes (Optional)</label>
          <textarea 
            name="notes" 
            rows="2"
            placeholder="Additional notes or instructions" 
            class="w-full p-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent"
          ></textarea>
        </div>
        
        <div class="flex justify-end gap-3">
          <button 
            type="button" 
            onclick="closeAddModal()" 
            class="px-6 py-3 bg-slate-200 text-slate-700 rounded-lg hover:bg-slate-300 transition-colors font-medium"
          >
            Cancel
          </button>
          <button 
            type="submit" 
            class="px-6 py-3 bg-gradient-to-r from-green-600 to-emerald-600 text-white rounded-lg hover:shadow-lg transition-all font-semibold"
          >
            Create Order
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Edit Order Modal -->
  <div id="editOrderModal" class="modal-overlay hidden flex justify-center items-center">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-3xl mx-4 overflow-hidden max-h-[90vh] overflow-y-auto">
      <div class="bg-gradient-to-r from-yellow-500 to-orange-500 px-6 py-4">
        <h2 class="text-2xl font-bold text-white">Edit Order Details</h2>
        <p class="text-yellow-100 text-sm">Update order information</p>
      </div>
      
      <form id="editOrderForm" action="/update-order" method="POST" class="p-6">
        <input type="hidden" name="orderId" id="editOrderId">
        
        <!-- Customer Information -->
        <div class="mb-6">
          <h3 class="text-lg font-semibold text-slate-800 mb-3 flex items-center">
            <svg class="w-5 h-5 mr-2 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
            </svg>
            Customer Information
          </h3>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-2">Order ID</label>
              <input 
                name="order_id" 
                type="text" 
                id="editOrderIdField"
                class="w-full p-3 border border-slate-300 rounded-lg bg-slate-50 focus:outline-none" 
                readonly
              />
            </div>
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-2">Customer Name</label>
              <input 
                name="customer_name" 
                type="text" 
                id="editCustomerName"
                class="w-full p-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent" 
                required
              />
            </div>
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-2">Email</label>
              <input 
                name="customer_email" 
                type="email" 
                id="editCustomerEmail"
                class="w-full p-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent" 
                required
              />
            </div>
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-2">Phone</label>
              <input 
                name="customer_phone" 
                type="tel" 
                id="editCustomerPhone"
                class="w-full p-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent" 
                required
              />
            </div>
          </div>
        </div>

        <!-- Product Information -->
        <div class="mb-6">
          <h3 class="text-lg font-semibold text-slate-800 mb-3 flex items-center">
            <svg class="w-5 h-5 mr-2 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
            </svg>
            Product Details
          </h3>
          <div class="grid grid-cols-3 gap-4">
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-2">Product Name</label>
              <input 
                name="product_name" 
                type="text" 
                id="editProductName"
                class="w-full p-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent" 
                required
              />
            </div>
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-2">Quantity</label>
              <input 
                name="quantity" 
                type="number" 
                min="1"
                id="editQuantity"
                oninput="calculateTotal('edit')"
                class="w-full p-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent" 
                required
              />
            </div>
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-2">Unit Price (₹)</label>
              <input 
                name="unit_price" 
                type="number" 
                step="0.01"
                min="0"
                id="editUnitPrice"
                oninput="calculateTotal('edit')"
                class="w-full p-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent" 
                required
              />
            </div>
          </div>
          <div class="mt-4">
            <label class="block text-sm font-semibold text-slate-700 mb-2">Total Amount (₹)</label>
            <input 
              name="total_amount" 
              type="number" 
              step="0.01"
              id="editTotalAmount"
              class="w-full p-3 border border-slate-300 rounded-lg bg-slate-50 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent" 
              readonly
              required
            />
          </div>
        </div>

        <!-- Order Details -->
        <div class="mb-6">
          <h3 class="text-lg font-semibold text-slate-800 mb-3 flex items-center">
            <svg class="w-5 h-5 mr-2 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
            </svg>
            Order Details
          </h3>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-2">Status</label>
              <select 
                name="status" 
                id="editStatus"
                class="w-full p-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent" 
                required
              >
                <option value="Pending">Pending</option>
                <option value="Processing">Processing</option>
                <option value="Shipped">Shipped</option>
                <option value="Delivered">Delivered</option>
                <option value="Cancelled">Cancelled</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-semibold text-slate-700 mb-2">Payment Method</label>
              <select 
                name="payment_method" 
                id="editPaymentMethod"
                class="w-full p-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent" 
                required
              >
                <option value="Cash">Cash</option>
                <option value="Card">Card</option>
                <option value="UPI">UPI</option>
                <option value="Net Banking">Net Banking</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Shipping Address -->
        <div class="mb-6">
          <label class="block text-sm font-semibold text-slate-700 mb-2">Shipping Address</label>
          <textarea 
            name="shipping_address" 
            rows="3"
            id="editShippingAddress"
            class="w-full p-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent" 
            required
          ></textarea>
        </div>

        <!-- Notes -->
        <div class="mb-6">
          <label class="block text-sm font-semibold text-slate-700 mb-2">Notes (Optional)</label>
          <textarea 
            name="notes" 
            rows="2"
            id="editNotes"
            class="w-full p-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent"
          ></textarea>
        </div>
        
        <div class="flex justify-end gap-3">
          <button 
            type="button" 
            onclick="closeEditModal()" 
            class="px-6 py-3 bg-slate-200 text-slate-700 rounded-lg hover:bg-slate-300 transition-colors font-medium"
          >
            Cancel
          </button>
          <button 
            type="submit" 
            class="px-6 py-3 bg-gradient-to-r from-yellow-500 to-orange-500 text-white rounded-lg hover:shadow-lg transition-all font-semibold"
          >
            Save Changes
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- View Order Modal -->
  <div id="viewOrderModal" class="modal-overlay hidden flex justify-center items-center">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-2xl mx-4 overflow-hidden">
      <div class="bg-gradient-to-r from-blue-600 to-indigo-600 px-6 py-4">
        <h2 class="text-2xl font-bold text-white">Order Details</h2>
        <p class="text-blue-100 text-sm" id="viewOrderId">Order #ORD001</p>
      </div>
      
      <div class="p-6">
        <div class="space-y-6">
          <!-- Customer Information -->
          <div>
            <h3 class="text-lg font-semibold text-slate-800 mb-3 flex items-center">
              <svg class="w-5 h-5 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
              </svg>
              Customer Information
            </h3>
            <div class="bg-slate-50 rounded-lg p-4 grid grid-cols-2 gap-4">
              <div>
                <p class="text-sm text-slate-600">Name</p>
                <p class="font-semibold text-slate-800" id="viewCustomerName">-</p>
              </div>
              <div>
                <p class="text-sm text-slate-600">Email</p>
                <p class="font-semibold text-slate-800" id="viewCustomerEmail">-</p>
              </div>
              <div>
                <p class="text-sm text-slate-600">Phone</p>
                <p class="font-semibold text-slate-800" id="viewCustomerPhone">-</p>
              </div>
            </div>
          </div>

          <!-- Product Information -->
          <div>
            <h3 class="text-lg font-semibold text-slate-800 mb-3 flex items-center">
              <svg class="w-5 h-5 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
              </svg>
              Product Details
            </h3>
            <div class="bg-slate-50 rounded-lg p-4 grid grid-cols-2 gap-4">
              <div>
                <p class="text-sm text-slate-600">Product</p>
                <p class="font-semibold text-slate-800" id="viewProductName">-</p>
              </div>
              <div>
                <p class="text-sm text-slate-600">Quantity</p>
                <p class="font-semibold text-slate-800" id="viewQuantity">-</p>
              </div>
              <div>
                <p class="text-sm text-slate-600">Unit Price</p>
                <p class="font-semibold text-slate-800" id="viewUnitPrice">-</p>
              </div>
              <div>
                <p class="text-sm text-slate-600">Total Amount</p>
                <p class="font-semibold text-green-600 text-lg" id="viewTotalAmount">-</p>
              </div>
            </div>
          </div>

          <!-- Order Status -->
          <div>
            <h3 class="text-lg font-semibold text-slate-800 mb-3 flex items-center">
              <svg class="w-5 h-5 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
              </svg>
              Order Status
            </h3>
            <div class="bg-slate-50 rounded-lg p-4 grid grid-cols-2 gap-4">
              <div>
                <p class="text-sm text-slate-600">Status</p>
                <span id="viewStatus" class="status-badge">-</span>
              </div>
              <div>
                <p class="text-sm text-slate-600">Payment Method</p>
                <p class="font-semibold text-slate-800" id="viewPaymentMethod">-</p>
              </div>
            </div>
          </div>

          <!-- Shipping Information -->
          <div>
            <h3 class="text-lg font-semibold text-slate-800 mb-3 flex items-center">
              <svg class="w-5 h-5 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              Shipping Address
            </h3>
            <div class="bg-slate-50 rounded-lg p-4">
              <p class="text-slate-800" id="viewShippingAddress">-</p>
            </div>
          </div>

          <!-- Notes -->
          <div id="viewNotesSection" style="display: none;">
            <h3 class="text-lg font-semibold text-slate-800 mb-3">Notes</h3>
            <div class="bg-slate-50 rounded-lg p-4">
              <p class="text-slate-800" id="viewNotes">-</p>
            </div>
          </div>
        </div>

        <div class="flex justify-end mt-6">
          <button 
            type="button" 
            onclick="closeViewModal()" 
            class="px-6 py-3 bg-slate-200 text-slate-700 rounded-lg hover:bg-slate-300 transition-colors font-medium"
          >
            Close
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Calculate total amount
    function calculateTotal(mode) {
      const quantityId = mode === 'add' ? 'addQuantity' : 'editQuantity';
      const priceId = mode === 'add' ? 'addUnitPrice' : 'editUnitPrice';
      const totalId = mode === 'add' ? 'addTotalAmount' : 'editTotalAmount';
      
      const quantity = parseFloat(document.getElementById(quantityId).value) || 0;
      const unitPrice = parseFloat(document.getElementById(priceId).value) || 0;
      const total = quantity * unitPrice;
      
      document.getElementById(totalId).value = total.toFixed(2);
    }

    // Toggle Dropdown Menu
    function toggleDropdown(dropdownId) {
      const dropdown = document.getElementById(dropdownId);
      const allDropdowns = document.querySelectorAll('.dropdown-menu');
      
      allDropdowns.forEach(menu => {
        if (menu.id !== dropdownId) {
          menu.classList.remove('active');
        }
      });
      
      dropdown.classList.toggle('active');
    }
    
    // Close dropdowns when clicking outside
    document.addEventListener('click', function(event) {
      if (!event.target.closest('.relative')) {
        document.querySelectorAll('.dropdown-menu').forEach(menu => {
          menu.classList.remove('active');
        });
      }
    });

    // Open Add Modal
    function openAddModal() {
      document.getElementById('addOrderModal').classList.remove('hidden');
    }

    // Close Add Modal
    function closeAddModal() {
      document.getElementById('addOrderModal').classList.add('hidden');
    }

    // NEW FUNCTION: Open Edit Modal from Card
    function openEditModalFromCard(button) {
      // Find the closest order card
      const orderCard = button.closest('.order-card');
      
      // Get the order data from the data attribute
      const orderData = orderCard.getAttribute('data-order');
      const order = JSON.parse(orderData);
      
      // Populate the edit modal
      openEditModal(order);
    }

    // Open Edit Modal
    function openEditModal(order) {
      document.getElementById('editOrderModal').classList.remove('hidden');
      document.getElementById('editOrderId').value = order._id;
      document.getElementById('editOrderIdField').value = order.order_id;
      document.getElementById('editCustomerName').value = order.customer_name;
      document.getElementById('editCustomerEmail').value = order.customer_email;
      document.getElementById('editCustomerPhone').value = order.customer_phone;
      document.getElementById('editProductName').value = order.product_name;
      document.getElementById('editQuantity').value = order.quantity;
      document.getElementById('editUnitPrice').value = order.unit_price;
      document.getElementById('editTotalAmount').value = order.total_amount;
      document.getElementById('editStatus').value = order.status;
      document.getElementById('editPaymentMethod').value = order.payment_method;
      document.getElementById('editShippingAddress').value = order.shipping_address;
      document.getElementById('editNotes').value = order.notes || '';
    }

    // Close Edit Modal
    function closeEditModal() {
      document.getElementById('editOrderModal').classList.add('hidden');
    }

    // View Order Details
    function viewOrder(orderId) {
      // Fetch order details
      fetch(`/orders/${orderId}`)
        .then(response => response.json())
        .then(order => {
          document.getElementById('viewOrderId').textContent = `Order #${order.order_id}`;
          document.getElementById('viewCustomerName').textContent = order.customer_name;
          document.getElementById('viewCustomerEmail').textContent = order.customer_email;
          document.getElementById('viewCustomerPhone').textContent = order.customer_phone;
          document.getElementById('viewProductName').textContent = order.product_name;
          document.getElementById('viewQuantity').textContent = order.quantity;
          document.getElementById('viewUnitPrice').textContent = `₹${order.unit_price.toLocaleString()}`;
          document.getElementById('viewTotalAmount').textContent = `₹${order.total_amount.toLocaleString()}`;
          
          const statusBadge = document.getElementById('viewStatus');
          statusBadge.textContent = order.status;
          statusBadge.className = `status-badge status-${order.status.toLowerCase()}`;
          
          document.getElementById('viewPaymentMethod').textContent = order.payment_method;
          document.getElementById('viewShippingAddress').textContent = order.shipping_address;
          
          if (order.notes) {
            document.getElementById('viewNotes').textContent = order.notes;
            document.getElementById('viewNotesSection').style.display = 'block';
          } else {
            document.getElementById('viewNotesSection').style.display = 'none';
          }
          
          document.getElementById('viewOrderModal').classList.remove('hidden');
        })
        .catch(error => {
          console.error('Error fetching order:', error);
          alert('Error loading order details');
        });
    }

    // Close View Modal
    function closeViewModal() {
      document.getElementById('viewOrderModal').classList.add('hidden');
    }

    // Delete Order
    function deleteOrder(orderId) {
      if (confirm('Are you sure you want to delete this order?')) {
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = '/delete-order/' + orderId;
        document.body.appendChild(form);
        form.submit();
      }
    }

    // Filter Orders
    function filterOrders() {
      const searchInput = document.getElementById('searchInput').value.toLowerCase();
      const orderCards = document.querySelectorAll('.order-card');
      
      orderCards.forEach(card => {
        const text = card.textContent.toLowerCase();
        if (text.includes(searchInput)) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    }

    // Close modal when clicking outside
    document.getElementById('addOrderModal').addEventListener('click', function(e) {
      if (e.target === this) {
        closeAddModal();
      }
    });

    document.getElementById('editOrderModal').addEventListener('click', function(e) {
      if (e.target === this) {
        closeEditModal();
      }
    });

    document.getElementById('viewOrderModal').addEventListener('click', function(e) {
      if (e.target === this) {
        closeViewModal();
      }
    });
  </script>
</body>
</html>
