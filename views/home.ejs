        <!-- Quick Actions -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-white rounded-2xl p-6 shadow-md">
            <h3 class="text-xl font-semibold text-slate-800 mb-4">
