  <script>
    // Toggle Dropdown Menu
    function toggleDropdown(dropdownId) {
      const dropdown = document.getElementById(dropdownId);
      const allDropdowns = document.querySelectorAll('.dropdown-menu');
      
      // Close all other dropdowns
      allDropdowns.forEach(menu => {
        if (menu.id !== dropdownId) {
          menu.classList.remove('active');
        }
      });
      
      // Toggle current dropdown
      dropdown.classList.toggle('active');
    }
    
    // Close dropdowns when clicking outside
    document.addEventListener('click', function(event) {
      if (!event.target.closest('.relative')) {
        document.querySelectorAll('.dropdown-menu').forEach(menu => {
          menu.classList.remove('active');
        });
      }
    });

    // Open Register Modal
    function openRegisterModal() {
      document.getElementById('registerVendorModal').classList.remove('hidden');
    }

    // Close Register Modal
    function closeRegisterModal() {
      document.getElementById('registerVendorModal').classList.add('hidden');
    }

    // Open Edit Modal
    function openEditModal(vendorId, vendorName, vendorEmail, vendorContact, vendorGstId) {
      document.getElementById('editVendorModal').classList.remove('hidden');
      document.getElementById('editVendorId').value = vendorId;
      document.getElementById('editName').value = vendorName;
      document.getElementById('editEmail').value = vendorEmail;
      document.getElementById('editContact').value = vendorContact;
      document.getElementById('editGstId').value = vendorGstId;
    }

    // Close Edit Modal
    function closeEditModal() {
      document.getElementById('editVendorModal').classList.add('hidden');
    }

    // Delete Vendor
    function deleteVendor(vendorId) {
      if (confirm('Are you sure you want to delete this vendor?')) {
        // Add your delete logic here
        console.log('Deleting vendor:', vendorId);
        // Example: window.location.href = '/delete-vendor/' + vendorId;
      }
    }

    // Filter Vendors
    function filterVendors() {
      const searchInput = document.getElementById('searchInput').value.toLowerCase();
      const vendorCards = document.querySelectorAll('.vendor-card');
      
      vendorCards.forEach(card => {
        const text = card.textContent.toLowerCase();
        if (text.includes(searchInput)) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    }

    // Close modal when clicking outside
    document.getElementById('registerVendorModal').addEventListener('click', function(e) {
      if (e.target === this) {
        closeRegisterModal();
      }
    });

    document.getElementById('editVendorModal').addEventListener('click', function(e) {
      if (e.target === this) {
        closeEditModal();
      }
    });
  </script>
