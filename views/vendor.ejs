<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Vendor Management</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
    
    body {
      font-family: 'Inter', sans-serif;
    }
    
    .modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-color: rgba(0, 0, 0, 0.5);
      backdrop-filter: blur(4px);
      z-index: 50;
    }
    
    .vendor-card {
      transition: all 0.3s ease;
    }
    
    .vendor-card:hover {
      transform: translateX(8px);
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
    }
    
    .dropdown-menu {
      display: none;
      position: absolute;
      right: 0;
      top: 100%;
      margin-top: 0.5rem;
      background: white;
      border-radius: 0.5rem;
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
      z-index: 10;
      min-width: 160px;
    }
    
    .dropdown-menu.active {
      display: block;
    }
    
    .dropdown-menu button {
      width: 100%;
      text-align: left;
      padding: 0.75rem 1rem;
      transition: background-color 0.2s;
    }
    
    .dropdown-menu button:hover {
      background-color: #f8fafc;
    }
  </style>
</head>
<body class="bg-gradient-to-br from-slate-50 to-slate-100 min-h-screen">
  
  <!-- Navigation Bar -->
  <nav class="bg-white shadow-md border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-6 py-4">
      <div class="flex items-center justify-between">
        <!-- Left Side: Back Button + Organization Name -->
        <div class="flex items-center space-x-4">
          <button onclick="window.history.back()" class="flex items-center space-x-2 px-4 py-2 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors">
            <svg class="w-5 h-5 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            <span class="text-slate-700 font-medium">Back</span>
          </button>
          
          <div class="h-8 w-px bg-slate-300"></div>
          
          <div>
            <h1 class="text-2xl font-bold text-slate-800">Inventory Pro</h1>
            <p class="text-xs text-slate-500">Vendor Management System</p>
          </div>
        </div>
        
        <!-- Right Side: Register Button -->
        <button onclick="openRegisterModal()" class="flex items-center space-x-2 px-6 py-3 bg-gradient-to-r from-blue-600 to-purple-600 text-white rounded-lg hover:shadow-lg transition-all font-semibold">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          <span>Register New Vendor</span>
        </button>
      </div>
    </div>
  </nav>

  <!-- Main Content -->
  <div class="max-w-7xl mx-auto px-6 py-8">
    
    <!-- Page Header -->
    <div class="mb-8">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-3xl font-bold text-slate-800 mb-2">Vendor Directory</h2>
          <p class="text-slate-600">Manage and view all registered vendors</p>
        </div>
        
        <!-- Search Bar -->
        <div class="relative">
          <input 
            type="text" 
            id="searchInput"
            placeholder="Search vendors..." 
            class="pl-10 pr-4 py-2 w-80 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent"
            onkeyup="filterVendors()"
          >
          <svg class="w-5 h-5 text-slate-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
      </div>
    </div>

    <!-- Stats Bar -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
      <div class="bg-white rounded-xl p-4 shadow-md border border-slate-200">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm text-slate-600">Total Vendors</p>
            <p class="text-2xl font-bold text-slate-800" id="totalVendors"><%= vendors.length %></p>
          </div>
          <div class="p-3 bg-blue-100 rounded-lg">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
            </svg>
          </div>
        </div>
      </div>
      
      <div class="bg-white rounded-xl p-4 shadow-md border border-slate-200">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm text-slate-600">Active</p>
            <p class="text-2xl font-bold text-green-600"><%= vendors.length %></p>
          </div>
          <div class="p-3 bg-green-100 rounded-lg">
            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
        </div>
      </div>
      
      <div class="bg-white rounded-xl p-4 shadow-md border border-slate-200">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm text-slate-600">GST Verified</p>
            <p class="text-2xl font-bold text-purple-600"><%= vendors.length %></p>
          </div>
          <div class="p-3 bg-purple-100 rounded-lg">
            <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
            </svg>
          </div>
        </div>
      </div>
      
      <div class="bg-white rounded-xl p-4 shadow-md border border-slate-200">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm text-slate-600">This Month</p>
            <p class="text-2xl font-bold text-orange-600"><%= vendors.length > 0 ? Math.min(2, vendors.length) : 0 %></p>
          </div>
          <div class="p-3 bg-orange-100 rounded-lg">
            <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
            </svg>
          </div>
        </div>
      </div>
    </div>

    <!-- Vendor List -->
    <div class="bg-white rounded-xl shadow-md border border-slate-200 overflow-hidden">
      <div class="px-6 py-4 bg-gradient-to-r from-slate-50 to-slate-100 border-b border-slate-200">
        <h3 class="text-lg font-semibold text-slate-800">All Vendors</h3>
      </div>
      
      <div id="vendorList" class="divide-y divide-slate-200">
        <% if (vendors.length === 0) { %>
          <div class="p-12 text-center">
            <svg class="w-16 h-16 text-slate-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
            </svg>
            <p class="text-slate-500 text-lg font-medium">No vendors registered yet</p>
            <p class="text-slate-400 text-sm mt-2">Click "Register New Vendor" to add your first vendor</p>
          </div>
        <% } else { %>
          <% 
          const colors = [
            'from-blue-500 to-purple-500',
            'from-green-500 to-teal-500',
            'from-orange-500 to-red-500',
            'from-pink-500 to-purple-500',
            'from-indigo-500 to-blue-500',
            'from-yellow-500 to-orange-500',
            'from-red-500 to-pink-500',
            'from-teal-500 to-green-500'
          ];
          
          vendors.forEach((vendor, index) => { 
            const colorClass = colors[index % colors.length];
            const initials = vendor.name.split(' ').map(word => word.charAt(0)).join('').substring(0, 2).toUpperCase();
          %>
            <div class="vendor-card p-6 hover:bg-slate-50" data-vendor-info="<%= vendor.vendorId %> <%= vendor.name %> <%= vendor.email %> <%= vendor.contact %> <%= vendor.gstId %>">
              <div class="flex items-center justify-between gap-4">
                <div class="flex items-center space-x-4 flex-1 min-w-0">
                  <!-- Vendor Avatar -->
                  <div class="w-14 h-14 flex-shrink-0 bg-gradient-to-br <%= colorClass %> rounded-full flex items-center justify-center text-white font-bold text-lg">
                    <%= initials %>
                  </div>
                  
                  <!-- Vendor Details -->
                  <div class="flex-1 grid grid-cols-5 gap-3 min-w-0">
                    <div class="min-w-0">
                      <p class="text-xs text-slate-500 mb-1">Vendor ID</p>
                      <p class="font-semibold text-slate-800 truncate"><%= vendor.vendorId %></p>
                    </div>
                    <div class="min-w-0">
                      <p class="text-xs text-slate-500 mb-1">Name</p>
                      <p class="font-semibold text-slate-800 truncate"><%= vendor.name %></p>
                    </div>
                    <div class="min-w-0">
                      <p class="text-xs text-slate-500 mb-1">Email</p>
                      <p class="text-slate-700 text-sm truncate"><%= vendor.email %></p>
                    </div>
                    <div class="min-w-0">
                      <p class="text-xs text-slate-500 mb-1">Contact</p>
                      <p class="text-slate-700 truncate"><%= vendor.contact %></p>
                    </div>
                    <div class="min-w-0">
                      <p class="text-xs text-slate-500 mb-1">GST ID</p>
                      <p class="text-slate-700 font-mono text-xs truncate"><%= vendor.gstId %></p>
                    </div>
                  </div>
                </div>
                
                <!-- Three Dot Menu -->
                <div class="relative flex-shrink-0">
                  <button onclick="toggleDropdown('dropdown<%= index %>')" class="p-2 hover:bg-slate-200 rounded-lg transition-colors">
                    <svg class="w-6 h-6 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"></path>
                    </svg>
                  </button>
                  <div id="dropdown<%= index %>" class="dropdown-menu">
                    <button onclick="openEditModal('<%= vendor._id %>', '<%= vendor.vendorId %>', '<%= vendor.name %>', '<%= vendor.email %>', '<%= vendor.contact %>', '<%= vendor.gstId %>'); toggleDropdown('dropdown<%= index %>')" class="flex items-center space-x-2 text-slate-700 hover:text-yellow-600">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                      </svg>
                      <span>Edit Vendor</span>
                    </button>
                    <form action="/delete-vendor/<%= vendor._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this vendor?');" class="m-0">
                      <button type="submit" class="flex items-center space-x-2 text-slate-700 hover:text-red-600 border-t border-slate-200">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                        </svg>
                        <span>Delete Vendor</span>
                      </button>
                    </form>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Register Vendor Modal -->
  <div id="registerVendorModal" class="modal-overlay hidden flex justify-center items-center">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-2xl mx-4 overflow-hidden">
      <div class="bg-gradient-to-r from-blue-600 to-purple-600 px-6 py-4">
        <h2 class="text-2xl font-bold text-white">Register New Vendor</h2>
        <p class="text-blue-100 text-sm">Add a new vendor to your directory</p>
      </div>
      
      <form action="/add-vendor" method="POST" class="p-6">
        <div class="grid grid-cols-2 gap-4 mb-4">
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2">Vendor ID</label>
            <input 
              name="vendorId" 
              type="text" 
              placeholder="e.g., V006" 
              class="w-full p-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent" 
              required 
            />
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2">Vendor Name</label>
            <input 
              name="name" 
              type="text" 
              placeholder="e.g., ABC Stores" 
              class="w-full p-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent" 
              required 
            />
          </div>
        </div>
        
        <div class="mb-4">
          <label class="block text-sm font-semibold text-slate-700 mb-2">Email Address</label>
          <input 
            name="email" 
            type="email" 
            placeholder="vendor@example.com" 
            class="w-full p-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent" 
            required 
          />
        </div>
        
        <div class="grid grid-cols-2 gap-4 mb-6">
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2">Contact Number</label>
            <input 
              name="contact" 
              type="tel" 
              placeholder="1234567890" 
              class="w-full p-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent" 
              required 
            />
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2">GST ID</label>
            <input 
              name="gstId" 
              type="text" 
              placeholder="22AAAAA0000A1Z5" 
              class="w-full p-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent" 
              required 
            />
          </div>
        </div>
        
        <div class="flex justify-end gap-3">
          <button 
            type="button" 
            onclick="closeRegisterModal()" 
            class="px-6 py-3 bg-slate-200 text-slate-700 rounded-lg hover:bg-slate-300 transition-colors font-medium"
          >
            Cancel
          </button>
          <button 
            type="submit" 
            class="px-6 py-3 bg-gradient-to-r from-blue-600 to-purple-600 text-white rounded-lg hover:shadow-lg transition-all font-semibold"
          >
            Register Vendor
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Edit Vendor Modal -->
  <div id="editVendorModal" class="modal-overlay hidden flex justify-center items-center">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-2xl mx-4 overflow-hidden">
      <div class="bg-gradient-to-r from-yellow-500 to-orange-500 px-6 py-4">
        <h2 class="text-2xl font-bold text-white">Edit Vendor Details</h2>
        <p class="text-yellow-100 text-sm">Update vendor information</p>
      </div>
      
      <form id="editVendorForm" action="/update-vendor" method="POST" class="p-6">
        <input type="hidden" name="vendorId" id="editVendorMongoId">
        
        <div class="mb-4">
          <label class="block text-sm font-semibold text-slate-700 mb-2">Vendor ID</label>
          <input 
            type="text" 
            id="editVendorId" 
            class="w-full p-3 border border-slate-300 rounded-lg bg-slate-100 cursor-not-allowed" 
            disabled
            readonly
          >
        </div>
        
        <div class="mb-4">
          <label class="block text-sm font-semibold text-slate-700 mb-2">Vendor Name</label>
          <input 
            name="name" 
            type="text" 
            id="editName" 
            class="w-full p-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent" 
            required
          >
        </div>
        
        <div class="mb-4">
          <label class="block text-sm font-semibold text-slate-700 mb-2">Email Address</label>
          <input 
            name="email" 
            type="email" 
            id="editEmail" 
            class="w-full p-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent" 
            required
          >
        </div>
        
        <div class="grid grid-cols-2 gap-4 mb-6">
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2">Contact Number</label>
            <input 
              name="contact" 
              type="tel" 
              id="editContact" 
              class="w-full p-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent" 
              required
            >
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-700 mb-2">GST ID</label>
            <input 
              name="gstId" 
              type="text" 
              id="editGstId" 
              class="w-full p-3 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent" 
              required
            >
          </div>
        </div>
        
        <div class="flex justify-end gap-3">
          <button 
            type="button" 
            onclick="closeEditModal()" 
            class="px-6 py-3 bg-slate-200 text-slate-700 rounded-lg hover:bg-slate-300 transition-colors font-medium"
          >
            Cancel
          </button>
          <button 
            type="submit" 
            class="px-6 py-3 bg-gradient-to-r from-yellow-500 to-orange-500 text-white rounded-lg hover:shadow-lg transition-all font-semibold"
          >
            Save Changes
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    // Toggle Dropdown Menu
    function toggleDropdown(dropdownId) {
      const dropdown = document.getElementById(dropdownId);
      const allDropdowns = document.querySelectorAll('.dropdown-menu');
      
      // Close all other dropdowns
      allDropdowns.forEach(menu => {
        if (menu.id !== dropdownId) {
          menu.classList.remove('active');
        }
      });
      
      // Toggle current dropdown
      dropdown.classList.toggle('active');
    }
    
    // Close dropdowns when clicking outside
    document.addEventListener('click', function(event) {
      if (!event.target.closest('.relative')) {
        document.querySelectorAll('.dropdown-menu').forEach(menu => {
          menu.classList.remove('active');
        });
      }
    });

    // Open Register Modal
    function openRegisterModal() {
      document.getElementById('registerVendorModal').classList.remove('hidden');
    }

    // Close Register Modal
    function closeRegisterModal() {
      document.getElementById('registerVendorModal').classList.add('hidden');
    }

    // Open Edit Modal
    function openEditModal(mongoId, vendorId, vendorName, vendorEmail, vendorContact, vendorGstId) {
      document.getElementById('editVendorModal').classList.remove('hidden');
      document.getElementById('editVendorMongoId').value = mongoId;
      document.getElementById('editVendorId').value = vendorId;
      document.getElementById('editName').value = vendorName;
      document.getElementById('editEmail').value = vendorEmail;
      document.getElementById('editContact').value = vendorContact;
      document.getElementById('editGstId').value = vendorGstId;
    }

    // Close Edit Modal
    function closeEditModal() {
      document.getElementById('editVendorModal').classList.add('hidden');
    }

    // Filter Vendors
    function filterVendors() {
      const searchInput = document.getElementById('searchInput').value.toLowerCase();
      const vendorCards = document.querySelectorAll('.vendor-card');
      
      vendorCards.forEach(card => {
        const vendorInfo = card.getAttribute('data-vendor-info').toLowerCase();
        if (vendorInfo.includes(searchInput)) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    }

    // Close modal when clicking outside
    document.getElementById('registerVendorModal').addEventListener('click', function(e) {
      if (e.target === this) {
        closeRegisterModal();
      }
    });

    document.getElementById('editVendorModal').addEventListener('click', function(e) {
      if (e.target === this) {
        closeEditModal();
      }
    });
  </script>
</body>
</html>
