<!--invoice.ejs-->

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Invoice Management</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
    
    body {
      font-family: 'Inter', sans-serif;
    }
    
    .modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-color: rgba(0, 0, 0, 0.5);
      backdrop-filter: blur(4px);
      z-index: 50;
    }
    
    .invoice-card {
      transition: all 0.3s ease;
    }
    
    .invoice-card:hover {
      transform: translateX(8px);
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
    }
    
    .dropdown-menu {
      display: none;
      position: absolute;
      right: 0;
      top: 100%;
      margin-top: 0.5rem;
      background: white;
      border-radius: 0.5rem;
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
      z-index: 10;
      min-width: 160px;
    }
    
    .dropdown-menu.active {
      display: block;
    }
    
    .dropdown-menu button {
      width: 100%;
      text-align: left;
      padding: 0.75rem 1rem;
      transition: background-color 0.2s;
    }
    
    .dropdown-menu button:hover {
      background-color: #f8fafc;
    }

    .status-badge {
      display: inline-block;
      padding: 0.25rem 0.75rem;
      border-radius: 9999px;
      font-size: 0.75rem;
      font-weight: 600;
    }

    .status-draft { background-color: #e2e8f0; color: #475569; }
    .status-sent { background-color: #dbeafe; color: #1e40af; }
    .status-paid { background-color: #dcfce7; color: #15803d; }
    .status-cancelled { background-color: #fee2e2; color: #b91c1c; }
    .status-overdue { background-color: #fef3c7; color: #a16207; }
  </style>
</head>
<body class="bg-gradient-to-br from-slate-50 to-slate-100 min-h-screen">
  
  <!-- Navigation Bar -->
  <nav class="bg-white shadow-md border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-6 py-4">
      <div class="flex items-center justify-between">
        <!-- Left Side: Back Button + Organization Name -->
        <div class="flex items-center space-x-4">
          <button onclick="window.history.back()" class="flex items-center space-x-2 px-4 py-2 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors">
            <svg class="w-5 h-5 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
            </svg>
            <span class="text-slate-700 font-medium">Back</span>
          </button>
          
          <div class="h-8 w-px bg-slate-300"></div>
          
          <div>
            <h1 class="text-2xl font-bold text-slate-800">Invoice Pro</h1>
            <p class="text-xs text-slate-500">Invoice Management System</p>
          </div>
        </div>
        
        <!-- Right Side: Create Invoice Button -->
        <a href="/invoice/create" class="flex items-center space-x-2 px-6 py-3 bg-gradient-to-r from-indigo-600 to-blue-600 text-white rounded-lg hover:shadow-lg transition-all font-semibold">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          <span>Create Invoice</span>
        </a>
      </div>
    </div>
  </nav>

  <!-- Main Content -->
  <div class="max-w-7xl mx-auto px-6 py-8">
    
    <!-- Page Header -->
    <div class="mb-8">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-3xl font-bold text-slate-800 mb-2">Invoice Dashboard</h2>
          <p class="text-slate-600">Manage and track all your invoices</p>
        </div>
        
        <!-- Search and Filter Bar -->
        <div class="flex items-center space-x-3">
          <div class="relative">
            <input 
              type="text" 
              id="searchInput"
              placeholder="Search invoices..." 
              class="pl-10 pr-4 py-2 w-80 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
              onkeyup="filterInvoices()"
            >
            <svg class="w-5 h-5 text-slate-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
          <select 
            id="statusFilter" 
            class="px-4 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500"
            onchange="filterInvoices()"
          >
            <option value="">All Status</option>
            <option value="Draft">Draft</option>
            <option value="Sent">Sent</option>
            <option value="Paid">Paid</option>
            <option value="Cancelled">Cancelled</option>
            <option value="Overdue">Overdue</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Stats Bar -->
    <div class="grid grid-cols-1 md:grid-cols-5 gap-4 mb-8">
      <div class="bg-white rounded-xl p-4 shadow-md border border-slate-200">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm text-slate-600">Total Invoices</p>
            <p class="text-2xl font-bold text-slate-800"><%= invoices.length %></p>
          </div>
          <div class="p-3 bg-indigo-100 rounded-lg">
            <svg class="w-6 h-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </div>
        </div>
      </div>
      
      <div class="bg-white rounded-xl p-4 shadow-md border border-slate-200">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm text-slate-600">Paid</p>
            <p class="text-2xl font-bold text-green-600"><%= invoices.filter(inv => inv.status === 'Paid').length %></p>
          </div>
          <div class="p-3 bg-green-100 rounded-lg">
            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
        </div>
      </div>
      
      <div class="bg-white rounded-xl p-4 shadow-md border border-slate-200">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm text-slate-600">Pending</p>
            <p class="text-2xl font-bold text-blue-600"><%= invoices.filter(inv => inv.status === 'Sent' || inv.status === 'Draft').length %></p>
          </div>
          <div class="p-3 bg-blue-100 rounded-lg">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
        </div>
      </div>
      
      <div class="bg-white rounded-xl p-4 shadow-md border border-slate-200">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm text-slate-600">Overdue</p>
            <p class="text-2xl font-bold text-orange-600"><%= invoices.filter(inv => inv.status === 'Overdue').length %></p>
          </div>
          <div class="p-3 bg-orange-100 rounded-lg">
            <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
            </svg>
          </div>
        </div>
      </div>
      
      <div class="bg-white rounded-xl p-4 shadow-md border border-slate-200">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm text-slate-600">Total Revenue</p>
            <p class="text-2xl font-bold text-purple-600">₹<%= invoices.filter(inv => inv.status === 'Paid').reduce((sum, inv) => sum + inv.total, 0).toLocaleString() %></p>
          </div>
          <div class="p-3 bg-purple-100 rounded-lg">
            <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
        </div>
      </div>
    </div>

    <!-- Invoice List -->
    <div class="bg-white rounded-xl shadow-md border border-slate-200">
      <div class="px-6 py-4 bg-gradient-to-r from-slate-50 to-slate-100 border-b border-slate-200">
        <h3 class="text-lg font-semibold text-slate-800">All Invoices</h3>
      </div>
      
      <div id="invoiceList" class="divide-y divide-slate-200">
        <% if (invoices.length === 0) { %>
          <div class="p-12 text-center">
            <svg class="w-16 h-16 text-slate-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
            <p class="text-slate-500 text-lg">No invoices found</p>
            <p class="text-slate-400 text-sm mt-2">Create your first invoice to get started</p>
            <a href="/invoice/create" class="inline-block mt-4 px-6 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition-colors">
              Create First Invoice
            </a>
          </div>
        <% } else { %>
          <% invoices.forEach((invoice, index) => { 
            const createdDate = new Date(invoice.createdAt).toLocaleDateString('en-IN');
            const dueDate = invoice.dueDate ? new Date(invoice.dueDate).toLocaleDateString('en-IN') : 'N/A';
          %>
            <div class="invoice-card p-6 hover:bg-slate-50" data-invoice-id="<%= invoice._id %>" data-status="<%= invoice.status %>">
              <div class="flex items-center justify-between gap-4">
                <div class="flex items-center space-x-4 flex-1 min-w-0">
                  <!-- Invoice Icon -->
                  <div class="w-14 h-14 flex-shrink-0 bg-gradient-to-br from-indigo-500 to-blue-500 rounded-full flex items-center justify-center text-white font-bold text-lg">
                    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                    </svg>
                  </div>
                  
                  <!-- Invoice Details -->
                  <div class="flex-1 grid grid-cols-7 gap-3 min-w-0">
                    <div class="min-w-0">
                      <p class="text-xs text-slate-500 mb-1">Invoice #</p>
                      <p class="font-semibold text-slate-800 truncate"><%= invoice.invoiceId %></p>
                    </div>
                    <div class="min-w-0">
                      <p class="text-xs text-slate-500 mb-1">Vendor</p>
                      <p class="font-semibold text-slate-800 truncate"><%= invoice.vendorName %></p>
                    </div>
                    <div class="min-w-0">
                      <p class="text-xs text-slate-500 mb-1">Amount</p>
                      <p class="text-slate-700 font-semibold truncate">₹<%= invoice.total.toLocaleString() %></p>
                    </div>
                    <div class="min-w-0">
                      <p class="text-xs text-slate-500 mb-1">Status</p>
                      <span class="status-badge status-<%= invoice.status.toLowerCase() %>"><%= invoice.status %></span>
                    </div>
                    <div class="min-w-0">
                      <p class="text-xs text-slate-500 mb-1">Items</p>
                      <p class="text-slate-700 truncate"><%= invoice.items.length %> item(s)</p>
                    </div>
                    <div class="min-w-0">
                      <p class="text-xs text-slate-500 mb-1">Created</p>
                      <p class="text-slate-700 text-sm truncate"><%= createdDate %></p>
                    </div>
                    <div class="min-w-0">
                      <p class="text-xs text-slate-500 mb-1">Due Date</p>
                      <p class="text-slate-700 text-sm truncate"><%= dueDate %></p>
                    </div>
                  </div>
                </div>
                
                <!-- Actions Menu -->
                <div class="relative flex-shrink-0">
                  <button onclick="toggleDropdown('dropdown<%= index %>')" class="p-2 hover:bg-slate-200 rounded-lg transition-colors">
                    <svg class="w-6 h-6 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"></path>
                    </svg>
                  </button>
                  <div id="dropdown<%= index %>" class="dropdown-menu">
                    <a href="/invoice/view/<%= invoice._id %>" class="flex items-center space-x-2 text-slate-700 hover:text-blue-600 px-4 py-3">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                      </svg>
                      <span>View Invoice</span>
                    </a>
                    <a href="/invoice/edit/<%= invoice._id %>" class="flex items-center space-x-2 text-slate-700 hover:text-yellow-600 px-4 py-3 border-t border-slate-200">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                      </svg>
                      <span>Edit Invoice</span>
                    </a>
                    <button onclick="updateStatus('<%= invoice._id %>', 'Paid'); toggleDropdown('dropdown<%= index %>')" class="flex items-center space-x-2 text-slate-700 hover:text-green-600 border-t border-slate-200">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                      </svg>
                      <span>Mark as Paid</span>
                    </button>
                    <button onclick="duplicateInvoice('<%= invoice._id %>'); toggleDropdown('dropdown<%= index %>')" class="flex items-center space-x-2 text-slate-700 hover:text-purple-600 border-t border-slate-200">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                      </svg>
                      <span>Duplicate</span>
                    </button>
                    <button onclick="deleteInvoice('<%= invoice._id %>'); toggleDropdown('dropdown<%= index %>')" class="flex items-center space-x-2 text-slate-700 hover:text-red-600 border-t border-slate-200">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                      </svg>
                      <span>Delete Invoice</span>
                    </button>
                  </div>
                </div>
              </div>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>
  </div>

  <script>
    // Toggle Dropdown Menu
    function toggleDropdown(dropdownId) {
      const dropdown = document.getElementById(dropdownId);
      const allDropdowns = document.querySelectorAll('.dropdown-menu');
      
      allDropdowns.forEach(menu => {
        if (menu.id !== dropdownId) {
          menu.classList.remove('active');
        }
      });
      
      dropdown.classList.toggle('active');
    }
    
    // Close dropdowns when clicking outside
    document.addEventListener('click', function(event) {
      if (!event.target.closest('.relative')) {
        document.querySelectorAll('.dropdown-menu').forEach(menu => {
          menu.classList.remove('active');
        });
      }
    });

    // Filter Invoices
    function filterInvoices() {
      const searchInput = document.getElementById('searchInput').value.toLowerCase();
      const statusFilter = document.getElementById('statusFilter').value;
      const invoiceCards = document.querySelectorAll('.invoice-card');
      
      invoiceCards.forEach(card => {
        const text = card.textContent.toLowerCase();
        const status = card.dataset.status;
        
        const matchesSearch = text.includes(searchInput);
        const matchesStatus = !statusFilter || status === statusFilter;
        
        if (matchesSearch && matchesStatus) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    }

    // Update Invoice Status
    async function updateStatus(invoiceId, status) {
      if (!confirm(`Mark this invoice as ${status}?`)) return;
      
      try {
        const response = await fetch(`/api/invoices/${invoiceId}/status`, {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ status })
        });

        if (response.ok) {
          window.location.reload();
        } else {
          alert('Failed to update invoice status');
        }
      } catch (error) {
        console.error('Error:', error);
        alert('An error occurred');
      }
    }

    // Duplicate Invoice
    async function duplicateInvoice(invoiceId) {
      if (!confirm('Create a duplicate of this invoice?')) return;
      
      try {
        const response = await fetch(`/api/invoices/${invoiceId}/duplicate`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          }
        });

        if (response.ok) {
          window.location.reload();
        } else {
          alert('Failed to duplicate invoice');
        }
      } catch (error) {
        console.error('Error:', error);
        alert('An error occurred');
      }
    }

    // Delete Invoice
    async function deleteInvoice(invoiceId) {
      if (!confirm('Are you sure you want to delete this invoice? This action cannot be undone.')) return;
      
      try {
        const response = await fetch(`/api/invoices/${invoiceId}`, {
          method: 'DELETE',
          headers: {
            'Content-Type': 'application/json',
          }
        });

        if (response.ok) {
          window.location.reload();
        } else {
          alert('Failed to delete invoice');
        }
      } catch (error) {
        console.error('Error:', error);
        alert('An error occurred');
      }
    }
  </script>
</body>
</html>
